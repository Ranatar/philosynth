{
  "name": "@philosynth/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "audit": "tsx audit.mts",
    "check:integration": "tsx integration-check.mts",
    "typecheck:checks": "tsc --noEmit -p tsconfig.checks.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "@hono/node-ws": "^1.3.1",
    "@philosynth/shared": "*",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "linkedom": "^0.18.13",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0"
  }
}
