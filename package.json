{
  "name": "philosynth-service",
  "version": "0.1.0",
  "private": true,
  "description": "PhiloSynth Service — веб-сервис генерации, хранения и редактирования философских концепций (Claude API)",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w packages/shared && npm run build -w server && npm run build -w client",
    "typecheck": "tsc -b packages/shared server client && npm run typecheck:checks -w server && npm run typecheck:scripts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "extract:seed": "node scripts/extract/extract-seed-data.mjs",
    "extract:sections": "node scripts/extract/extract-section-templates.mjs",
    "extract:export-assets": "node scripts/extract/extract-export-assets.mjs",
    "seed:prompts": "tsx scripts/seed/seed-prompts.ts",
    "seed:configs": "tsx scripts/seed/seed-configs.ts",
    "seed:taxonomy": "tsx scripts/seed/seed-taxonomy.ts",
    "seed:admin": "tsx scripts/seed/bootstrap-admin.ts",
    "seed:plans": "tsx scripts/seed/seed-plans.ts",
    "stripe:create-prices": "tsx scripts/seed/stripe-create-prices.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:dotfiles": "node scripts/checks/check-dotfiles.mjs",
    "i18n:extract": "node scripts/i18n/extract-ui-strings.mjs",
    "i18n:build": "node scripts/i18n/build-localized.mjs",
    "i18n:init": "node scripts/i18n/i18n-init.mjs",
    "i18n:codemod": "node scripts/i18n/i18n-codemod.mjs",
    "i18n:export": "node scripts/i18n/i18n-export.mjs",
    "i18n:import": "node scripts/i18n/i18n-import.mjs",
    "i18n:check": "node scripts/i18n/i18n-check.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
