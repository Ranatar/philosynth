{
  "name": "philosynth-service",
  "version": "0.1.0",
  "private": true,
  "description": "PhiloSynth Service — веб-сервис генерации, хранения и редактирования философских концепций (Claude API)",
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w packages/shared && npm run build -w server && npm run build -w client",
    "typecheck": "tsc -b packages/shared server client && npm run typecheck:checks -w server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "extract:seed": "node scripts/extract-seed-data.mjs",
    "seed:prompts": "tsx scripts/seed-prompts.ts",
    "seed:configs": "tsx scripts/seed-configs.ts",
    "seed:taxonomy": "tsx scripts/seed-taxonomy.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
