# ── Окружение philosynth-service (05-file-structure) ──
# Скопировать в .env и заполнить. Значения ниже — dev-дефолты из server/env.ts.

# PostgreSQL. ВАЖНО: пароль обязан совпадать с дефолтом server/env.ts,
# иначе tsx-скрипты (сиды, тесты, integration-check) получат 28P01:
# .env читает только drizzle-kit, скрипты берут значения из process.env.
DATABASE_URL=postgres://philosynth:philosynth_dev@localhost:5432/philosynth

# Redis (кэш Prompt Registry, сессии, rate limiting). Кэш fail-open.
REDIS_URL=redis://localhost:6379

# Сервер
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Claude API (беседа 1.4). Пусто — генерация недоступна, остальное работает.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=20000
# База API: подмена в тестах (мок-SSE) или при прокси (беседа 1.4)
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Порог «зависшего» стрима, мс (err.kind='stuck', 01-arch §4.12)
STREAM_STUCK_MS=45000

# Сессии (Lucia, беседа 0.2)
SESSION_COOKIE_NAME=philosynth_session
SESSION_COOKIE_SECURE=false

# Шифрование пользовательских API-ключей, BYO-Key (беседа 6.1)
API_KEY_ENCRYPTION_SECRET=
# Наценка сервиса к себестоимости API (pay-as-you-go, беседа 6.1)
BILLING_MARKUP=1.2
# Stripe (биллинг, беседа 6.1). Пусто — пополнение и подписки отвечают 503,
# BYO-Key и списания с баланса работают.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# База REST API Stripe (мок в тестах)
STRIPE_API_BASE=https://api.stripe.com
# Price ID тарифов (беседа 8.3). Заводятся `npm run stripe:create-prices`
# ключом владельца; без них `npm run seed:plans` заведёт планы
# НЕАКТИВНЫМИ и предупредит — раздел подписки останется пустым.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ACADEMIC=
# Принуждение биллинга (6.1): true — без BYO/подписки/баланса генерация
# отклоняется; дефолт: true в production, false иначе (баланс уходит в минус)
BILLING_ENFORCE=
# Минимальный резерв баланса для запуска операции в режиме balance, $
BILLING_MIN_RESERVE_USD=0.05

# Задержки ретраев pre-stream, мс через запятую (streamResp [12642], беседа 1.4)
STREAM_RETRY_DELAYS=1000,3000,8000

# Лимиты (03-spec §3.4; rate-limiter беседы 0.2 работает fail-open)
RATE_LIMIT_CONCURRENT_GENERATIONS=3
RATE_LIMIT_WS_MESSAGES_PER_MINUTE=60
RATE_LIMIT_HTTP_PER_MINUTE=60

# ─── Почта (беседа 9.1): подтверждение адреса и сброс пароля ─────────
# 'smtp' — отправка через SMTP; 'console' — письмо печатается в вывод
# сервера вместо отправки (стенд и разработка работают без почтового узла).
# Пусто → 'console' вне production, 'smtp' в production.
# В production пустой SMTP_HOST или MAIL_FROM → сервер НЕ ЗАПУСКАЕТСЯ.
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true — TLS с первого байта (порт 465); false — STARTTLS (порт 587)
SMTP_SECURE=false
# Адрес отправителя, например: PhiloSynth <no-reply@example.org>
MAIL_FROM=
# База ссылок в письмах — адрес КЛИЕНТА; пусто → CLIENT_ORIGIN
PUBLIC_BASE_URL=http://localhost:5173
# Период разбора очереди писем, мс; задержки повторов при временном
# отказе, мс через запятую (1 мин, 5, 15, 60, 6 ч; попыток = задержек + 1)
MAIL_WORKER_INTERVAL_MS=5000
MAIL_RETRY_DELAYS=60000,300000,900000,3600000,21600000
# Запросов, порождающих письмо, в час на сессию/IP
RATE_LIMIT_MAIL_PER_HOUR=10

# ─── Клиент (vite, беседа 6.2) ────────────────────────────────────────
# Publishable key Stripe для Payment Element на странице биллинга.
# Пусто → dev-режим: пополнение подтверждается сервером напрямую
# (POST /billing/topup/confirm; с моком Stripe PaymentIntent уже succeeded).
VITE_STRIPE_PUBLISHABLE_KEY=
