+check("union AdminAction ≡ ADMIN_ACTIONS", JSON.stringify(unionVals.sort()) === JSON.stringify([...expected].sort()), unionVals);
+check("isAdminAction", audit.isAdminAction("user.role.changed") && !audit.isAdminAction("user.deleted"));
