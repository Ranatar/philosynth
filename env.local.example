# ── Окружение ЛОКАЛЬНОГО СТЕНДА биллинга (беседа 8.2; файл без ведущей точки
#    с 8.6 — загрузка «Add files via upload» четыре раза подряд теряла
#    dotfile, см. 09 §2). Копируется в .env.local скриптом tools/dev-billing.sh.
#    Всё фиктивное: мок Stripe вместо api.stripe.com, ключи не настоящие.

DATABASE_URL=postgres://philosynth:philosynth_dev@localhost:5432/philosynth
REDIS_URL=redis://localhost:6379
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5199

# Мок Stripe (tools/stripe-mock.mjs): порт и фиктивный ключ; сервер идёт в мок
STRIPE_MOCK_PORT=3866
STRIPE_MOCK_SECRET_KEY=sk_test_mock
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_API_BASE=http://127.0.0.1:3866
# Пусто — подпись webhook вне production не проверяется (09 §9 п.3д)
STRIPE_WEBHOOK_SECRET=
# PaymentIntent мока рождается сразу succeeded — dev-подтверждение /topup/confirm
STRIPE_MOCK_PI_STATUS=succeeded

# Биллинг принудительный — иначе стенд ничего не проверяет
BILLING_ENFORCE=true
BILLING_MARKUP=1.2
BILLING_MIN_RESERVE_USD=0.05
API_KEY_ENCRYPTION_SECRET=dev-billing-stand-secret

# 8.3: Price ID тарифов — мок Price не проверяет, планы сеются активными
STRIPE_PRICE_STARTER=price_mock_starter
STRIPE_PRICE_PRO=price_mock_pro
STRIPE_PRICE_ACADEMIC=price_mock_academic

# Первый администратор для npm run seed:admin (по желанию)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ─── Клиент (vite) ─── ПУСТО: с publishable key Stripe.js пошёл бы в
# настоящий api.stripe.com с client_secret от мока и упал
VITE_STRIPE_PUBLISHABLE_KEY=
